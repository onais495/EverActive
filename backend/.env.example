PORT=3000
DATABASE_URL=mysql://everactive:everactive@mysql:3306/everactive

# Eventbrite private token: eventbrite.com > Account settings > Developer links > API keys
EVENTBRITE_TOKEN=
# Daily event sync. Leave false locally so dev never calls Eventbrite by accident.
EVENT_SYNC_ENABLED=false
EVENT_SYNC_INTERVAL_HOURS=24

# Gemini API key from https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite (gemini-3.8-flash is smarter but often overloaded)
GEMINI_MODEL=

# Email (confirmation and password reset codes) through Brevo's HTTPS API. Free: 300 emails/day.
# Railway blocks SMTP below the Pro plan, so this uses HTTPS instead. Leave blank to skip sending.
# Key: brevo.com > SMTP & API > API keys. EMAIL_FROM must be a sender verified in Brevo (Senders, domains).
BREVO_API_KEY=
EMAIL_FROM=
